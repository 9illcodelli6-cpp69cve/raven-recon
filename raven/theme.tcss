Screen { background: #0b1020; color: #dce6f5; }
#topbar { height: 3; background: #121b30; padding: 0 2; border-bottom: solid #263650; }
#brand { width: 22; color: #b39aff; text-style: bold; content-align: left middle; }
#project-name { width: 1fr; content-align: left middle; }
#run-state { width: 25; color: #60e5cf; text-align: right; content-align: right middle; }
#body { height: 1fr; }
#sidebar { width: 26; background: #10182a; padding: 0 1; border-right: solid #263650; }
.section { height: 2; padding-top: 1; color: #7486a7; text-style: bold; }
#tagline { height: 3; color: #cbb8ff; text-style: bold; padding-top: 1; }
Checkbox { border: none; background: transparent; padding: 0; height: 2; }
Checkbox:focus { background: #202c47; }
#sidebar Button { width: 100%; min-width: 12; height: 3; margin-bottom: 0; border: tall #293655; background: #17233c; }
#sidebar #run { background: #7153b8; border: tall #7153b8; margin-top: 1; }
#sidebar #stop { color: #ffadab; }
#limits { margin-top: 2; color: #8290a8; height: auto; }
#main { padding: 0 1; width: 1fr; }
#metrics { height: 5; margin-top: 1; }
.metric { width: 1fr; height: 4; border-left: thick #9679e4; background: #141e34; padding: 0 2; margin-right: 1; content-align: left middle; }
#search { height: 3; border: tall #263650; background: #111b2e; margin-bottom: 1; }
#search:focus { border: tall #9679e4; }
#tabs { height: 1fr; min-height: 5; }
TabPane { padding: 0; }
DataTable { height: 1fr; background: #0e1628; }
DataTable > .datatable--header { background: #202d49; color: #9daccc; text-style: bold; }
DataTable > .datatable--cursor { background: #433263; color: #ffffff; }
DataTable > .datatable--odd-row { background: #111b2e; }
#table-hint { height: 1; color: #8290a8; margin-top: 1; }
#progress { height: 1; margin: 1 0 0 0; }
#events { height: 6; min-height: 3; border-top: solid #263650; background: #0a1120; color: #91a4bf; padding: 0 1; }
Footer { background: #17233b; }
Details, FileImport { align: center middle; background: #050912 80%; }
#detail-dialog { width: 88%; height: 82%; border: thick #9679e4; background: #111b30; padding: 1 2; }
#detail-dialog VerticalScroll { height: 1fr; margin: 1 0; }
#detail-dialog Button { width: 22; height: 3; }
#import-dialog { width: 76; height: auto; border: thick #9679e4; background: #111b30; padding: 1 2; }
#import-dialog Label { margin-bottom: 1; }
.dialog-title { color: #cbb8ff; text-style: bold; height: 1; }
.dialog-buttons { height: 3; margin-top: 1; }
.dialog-buttons Button { margin-right: 2; }
.muted { color: #8290a8; height: auto; }
